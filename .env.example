# Sao chép thành .env rồi điền. KHÔNG đưa .env lên GitHub.

# --- Neon Postgres: Dashboard -> Connect -> chọn "Pooled connection" -> copy chuỗi ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Kho ảnh: lưu ngay trong Neon (ảnh 320px, Neon free 0.5 GB ~ 500 người x 20 ảnh). Không cần dịch vụ ngoài. ---
STORAGE_BACKEND=db

# --- Quản trị: dùng ADMIN_TOKEN (Bearer) hoặc cặp ADMIN_USER/ADMIN_PASSWORD (Basic). Đặt chuỗi dài ngẫu nhiên. ---
ADMIN_TOKEN=doi-thanh-chuoi-dai-ngau-nhien
ADMIN_USER=
ADMIN_PASSWORD=

# --- Tuỳ chọn ---
ENROLL_CODE=                 # nếu đặt: thành viên phải nhập "mã CLB" này mới đăng ký được (chống người lạ nạp ảnh)
ALLOWED_ORIGINS=             # vd https://ten-ban.onrender.com (nhiều giá trị: phẩy). Để trống = chỉ cùng domain
MIN_FRAMES=20
MAX_FRAMES=30
MAX_TOTAL_PER_MEMBER=60
ENABLE_TILT_POSES=0          # 1 = thêm 2 tư thế nghiêng đầu
RATE_LIMIT_PER_HOUR=10       # số lần đăng ký/giờ/IP
# Chỉ để thử trên máy, KHÔNG dùng khi deploy: STORAGE_BACKEND=local lưu ảnh vào ./local_store

# Chỉ khi tách frontend (Vercel) khỏi backend (Render): API_ONLY=1 và ALLOWED_ORIGINS=https://ten.vercel.app
API_ONLY=0

# Token CHỈ-ĐỌC cho hệ thống nhận diện tự kéo dữ liệu (tools/sync_enrollment.py): đọc manifest + ảnh + đánh dấu đã xuất, không xoá/sửa được gì.
SYNC_TOKEN=
